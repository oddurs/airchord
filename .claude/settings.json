{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      "public/mediapipe"
    ],
    "baseRef": "fresh"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/lane.mjs hook session-start 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/lane.mjs hook guard 2>/dev/null || true",
            "if": "Bash(git *)",
            "timeout": 15,
            "statusMessage": "Checking the branch"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/lane.mjs hook touched 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/lane.mjs hook checkpoint 2>/dev/null || true",
            "timeout": 60,
            "statusMessage": "Checkpointing the lane"
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
