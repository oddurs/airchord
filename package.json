{
  "name": "airchord",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/assets.mjs",
    "certs": "node scripts/certs.mjs",
    "dev": "npm run assets && node server.mjs",
    "build": "npm run assets && next build",
    "start": "NODE_ENV=production node server.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test && BUILD_DIR=.next-verify npm run build",
    "audio": "node scripts/audio-check.mjs",
    "build:pages": "npm run assets && STATIC_EXPORT=1 NEXT_PUBLIC_BASE_PATH=/airchord next build",
    "preview": "node scripts/serve-static.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "next": "^15.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5.6.3"
  }
}
